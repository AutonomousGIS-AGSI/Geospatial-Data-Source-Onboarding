# Copy to .env. Keys entered in the web UI take precedence per request;
# these are used by background work and when no key is supplied.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Comma-separated API keys, or user ids (sha256(key)[:16]), with admin rights.
AGM_ADMIN_API_KEYS=
AGM_ADMIN_USER_IDS=

# Mapbox public token (pk....) for the output map previews. Without one the
# previews use OpenLayers + OpenStreetMap tiles.
MAPBOX_TOKEN=

# Where retrieved data is written (defaults to a per-user app-data folder).
GIS_COSCI_OUTPUT_ROOT=

# Port for `python WebUI/app.py` (default 4041).
PORT=4041
